meta {
  name: Record Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/invoices/{{invoiceId}}/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "amount": 5000,
    "paymentMethod": "UPI",
    "referenceNumber": "UPI-TXN-9876543210",
    "notes": "Received via GPay QR"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.data && data.data.id) {
      bru.setVar("paymentId", data.data.id);
      bru.setEnvVar("paymentId", data.data.id);
    }
  }
}
