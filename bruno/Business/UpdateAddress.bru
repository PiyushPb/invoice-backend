meta {
  name: Update Business Address
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/business/addresses/:addressId
  body: json
  auth: bearer
}

params:path {
  addressId: 00000000-0000-0000-0000-000000000000
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "addressLine2": "Level 4, Outer Ring Road",
    "landmark": "Near Bellandur Flyover",
    "isPrimary": true
  }
}
