meta {
  name: Get Bank Account UPI QR
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/business/bank-accounts/{{bankAccountId}}/upi-qr?amount=1500.00&note=Invoice%20INV-2024-001
  body: none
  auth: bearer
}

params:query {
  amount: 1500.00
  note: Invoice INV-2024-001
}

auth:bearer {
  token: {{accessToken}}
}
