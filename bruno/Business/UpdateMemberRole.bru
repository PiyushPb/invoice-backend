meta {
  name: Update Member Role
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/business/members/:memberId
  body: json
  auth: bearer
}

params:path {
  memberId: 00000000-0000-0000-0000-000000000000
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "role": "ACCOUNTANT"
  }
}
