meta {
  name: Update Tax Profile
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/business/tax-profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "taxRegistered": true,
    "gstin": "29ABCDE1234F1Z5",
    "gstRegistrationType": "REGULAR",
    "pan": "ABCDE1234F",
    "tan": "ABCD12345E",
    "taxpayerName": "Acme Global Solutions Pvt Ltd",
    "defaultTaxRate": 18,
    "defaultTaxMode": "TAX_EXCLUSIVE",
    "placeOfSupplyStateCode": "KA",
    "reverseChargeEnabled": false
  }
}
