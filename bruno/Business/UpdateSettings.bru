meta {
  name: Update Settings
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/business/settings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "invoicePrefix": "INV",
    "defaultInvoiceNumber": "1001",
    "defaultDueDays": 15,
    "defaultNotes": "Thank you for doing business with us.",
    "defaultTerms": "Payment due within 15 days of invoice date.",
    "invoiceTemplate": "DEFAULT",
    "defaultTaxMode": "TAX_EXCLUSIVE",
    "showLogo": true,
    "showBankDetails": true,
    "showSignature": true
  }
}
