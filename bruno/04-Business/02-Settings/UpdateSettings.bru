meta {
  name: Update Business Settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/business/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "invoicePrefix": "INV-",
    "invoiceSequenceNumber": 1,
    "defaultPaymentTermsDays": 15,
    "defaultNotes": "Thank you for partnering with us!",
    "defaultTerms": "Payment due within 15 days of invoice date.",
    "taxMode": "TAX_EXCLUSIVE"
  }
}

