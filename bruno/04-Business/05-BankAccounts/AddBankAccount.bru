meta {
  name: Add Bank Account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/business/bank-accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "accountName": "Acme Global Solutions Pvt Ltd",
    "bankName": "HDFC Bank",
    "accountNumber": "50200012345678",
    "ifscCode": "HDFC0001234",
    "branchName": "Indiranagar",
    "accountType": "CURRENT",
    "upiId": "acme@hdfcbank",
    "isPrimary": true,
    "showOnInvoice": true
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.data && data.data.id) {
      bru.setVar("bankAccountId", data.data.id);
      bru.setEnvVar("bankAccountId", data.data.id);
    }
  }
}
