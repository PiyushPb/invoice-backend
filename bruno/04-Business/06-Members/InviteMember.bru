meta {
  name: Invite Team Member
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/business/members/invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "accountant@acmeglobal.com",
    "role": "ACCOUNTANT"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.data && data.data.id) {
      bru.setVar("memberId", data.data.id);
      bru.setEnvVar("memberId", data.data.id);
    }
  }
}
