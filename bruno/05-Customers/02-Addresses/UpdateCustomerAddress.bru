meta {
  name: Update Customer Address
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/customers/{{customerId}}/addresses/{{customerAddressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "addressLine1": "123 Marine Drive, Suite 500",
    "postalCode": "400021"
  }
}

